# ===========================================
# FeedPulse Environment Configuration
# ===========================================

# Database
DATABASE_URL=postgresql://feedpulse:feedpulse_secret@localhost:5454/feedpulse
POSTGRES_USER=feedpulse
POSTGRES_PASSWORD=feedpulse_secret
POSTGRES_DB=feedpulse

# Redis (for job queue)
REDIS_URL=redis://localhost:6399

# Backend
BACKEND_PORT=3838
BACKEND_HOST=0.0.0.0
NODE_ENV=development

# Frontend
FRONTEND_PORT=3737
NEXT_PUBLIC_API_URL=http://localhost:3838
NEXT_PUBLIC_USE_MOCK=false

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OpenAI / LiteLLM
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
# For LiteLLM proxy, use: http://localhost:4000
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Feed Processing
FEED_UPDATE_INTERVAL_HOURS=1
USE_READABILITY_DEFAULT=true
MAX_CONCURRENT_FEED_UPDATES=5

# CORS
CORS_ORIGIN=http://localhost:3737

# Logging
LOG_LEVEL=info
